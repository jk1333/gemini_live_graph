# Option 1 (Default): Google Cloud Vertex AI (Gemini Enterprise Agent Platform)
# Run `gcloud auth application-default login` prior to starting the app.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option 2 (Fallback): Gemini Developer API
# Used automatically if GOOGLE_CLOUD_PROJECT is not set.
# GEMINI_API_KEY=your-gemini-api-key

# Target Gemini Live 3.8 Model
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional Safety Filter Settings applied during initial BidiGenerateContentSetup
# Allowed presets: DEFAULT, BLOCK_LOW_AND_ABOVE, BLOCK_MEDIUM_AND_ABOVE, BLOCK_ONLY_HIGH, BLOCK_NONE, OFF
# GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# Optional per-category JSON override (takes precedence over GEMINI_SAFETY_THRESHOLD):
# GEMINI_SAFETY_SETTINGS_JSON=[{"category":"HARM_CATEGORY_HARASSMENT","threshold":"BLOCK_LOW_AND_ABOVE"},{"category":"HARM_CATEGORY_HATE_SPEECH","threshold":"BLOCK_LOW_AND_ABOVE"}]

# Google Cloud Model Armor (`sanitizeUserPrompt`) Input Guardrail Settings
MODEL_ARMOR_ENABLED=true
MODEL_ARMOR_TEMPLATE_ID=airline-chatbot-guardrail
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_AUTO_CREATE_TEMPLATE=true
