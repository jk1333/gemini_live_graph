# Option 1 (Default): Google Cloud Vertex AI (Gemini Enterprise Agent Platform)
# Run `gcloud auth application-default login` prior to starting the CLI.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option 2 (Fallback): Gemini Developer API
# Used automatically if GOOGLE_CLOUD_PROJECT is not set.
# GEMINI_API_KEY=your-gemini-api-key

# Target Gemini Live 3.8 Model
GEMINI_LIVE_MODEL=gemini-3.8-live
